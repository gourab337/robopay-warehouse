<?xml version="1.0"?>
<package format="3">
  <name>robopay_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 bridge: a robot with its own wallet takes jobs on HSK Chain, drives with Nav2, and gets paid.</description>
  <maintainer email="gourab@loafmarkets.com">USYDRobotics</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <buildtool_depend>ament_python</buildtool_depend>
  <export><build_type>ament_python</build_type></export>
</package>
